{
  "name": "gcode-preview-vue",
  "version": "0.1.0",
  "private": true,
  "description": "Vue 3 component for gcode-preview: render a 3D preview of G-code on a canvas",
  "keywords": [
    "gcode",
    "g-code",
    "3d-printing",
    "preview",
    "three",
    "vue",
    "vue3",
    "component"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyz-tools/gcode-preview-vue.git"
  },
  "homepage": "https://github.com/xyz-tools/gcode-preview-vue#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts && vue-tsc -p tsconfig.build.json && node scripts/fix-dts.js",
    "build:demo": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint:package": "publint"
  },
  "peerDependencies": {
    "gcode-preview": "^3.0.0-alpha.6",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@types/three": "~0.185.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "gcode-preview": "^3.0.0-alpha.6",
    "happy-dom": "^20.14.5",
    "publint": "^0.3.25",
    "typescript": "~6.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
